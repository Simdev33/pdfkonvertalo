# Copy to .env.local (never commit real keys).

# Stripe – test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: existing Price IDs. When empty, the app creates (once) and reuses
# "PDF Konvertáló" prices by lookup key: 1.00 EUR one-time trial fee and
# 9.90 EUR / month subscription.
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_MONTHLY=

# Signs the login cookies. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Login codes by e-mail via https://resend.com (free up to 3,000 e-mails / month).
# Without a key the code is printed to the server log (development only).
RESEND_API_KEY=
EMAIL_FROM="ConvertPDFNow <no-reply@convertpdfnow.com>"

# Canonical site URL (links, sitemap, Stripe return URLs).
NEXT_PUBLIC_SITE_URL=
